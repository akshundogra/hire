<!-- End TrustBox widget --></div><div class="flex flex-col items-center min-h-screen mx-auto w-full"><div id="background" class="bg-pageBG w-full"><script type="application/ld+json">{"@context":"https://schema.org/","@type":"Product","name":"Dandy Presents: Desperate Dan by Jamie Smart Vol. 1 & 2","image":["https://cms.dcthomsonshop.co.uk/wp-content/uploads/2026/04/Dandy-Preesnts-Desperate-Dan-by-Jamie-Smart-pack.png"],"description":"<p>Get ready for the ultimate Desperate Dan collection, bringing together volumes 1 and 2 of Jamie Smart’s brilliantly bonkers take on the world’s strongest cowboy. Packed with slapstick, surreal humour and wild western chaos, this two‑bookazine set delivers double the laughs – with free delivery.</p>\n<p>Whether you’re discovering Desperate Dan for the first time or building a must‑have comic collection, this two‑volume set is the perfect way to experience one of Britain’s funniest cowboys.</p>\n<p>Double the books. Double the laughs. Free delivery included.</p>\n","brand":{"@type":"Brand","name":"Beano and The Dandy"},"offers":{"@type":"AggregateOffer","priceCurrency":"GBP","lowPrice":"17.00","highPrice":"17.00","offerCount":1,"seller":{"@type":"Organization","name":"Beano and The Dandy"},"offers":[{"@type":"Offer","sku":"DCPP-DANJS2","price":"17.00","priceCurrency":"GBP","availability":"https://schema.org/InStock","itemCondition":"https://schema.org/NewCondition"}]}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"/"},{"@type":"ListItem","position":2,"name":"Our latest books & bookazines","item":"/books-bookazines"},{"@type":"ListItem","position":3,"name":"Beano & The Dandy Annuals & Specials","item":"/beano-dandy-comic-specials"},{"@type":"ListItem","position":4,"name":"Dandy Presents: Desperate Dan by Jamie Smart Vol. 1 & 2","item":"/dandy-presents-desperate-dan-by-jamie-smart-vol-1-2"}]}</script><div clas